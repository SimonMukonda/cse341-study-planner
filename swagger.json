      "type": "object",
      "required": [
        "courseCode",
        "title",
        "semester"
      ],
      "properties": {
        "courseCode": {
          "type": "string",
          "example": "CSE341"
        },
        "title": {
          "type": "string",
          "example": "Web Services"
        },
        "instructor": {
          "type": "string",
          "example": "Brother Smith"
        },
        "semester": {
          "type": "string",
          "example": "Fall 2026"
        },
        "credits": {
          "type": "number",
          "example": 3
        },
        "meetingDays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": [
            "Mon",
            "Wed"
          ]
        },
        "meetingTime": {
          "type": "string",
          "example": "10:00 AM"
        },
        "location": {
          "type": "string",
          "example": "Online"
        }
      }
